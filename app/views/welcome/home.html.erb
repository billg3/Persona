<div class="morning-app">
  <header class="hero">
    <p class="eyebrow">Morning in Manhattan</p>
    <h1>Persona Morning Social</h1>
    <p class="hero-copy">
      Start your day with skyline energy, hop into a Zoom room with other early risers,
      and let your AI conversation coach suggest what to ask next.
    </p>

    <div class="hero-actions">
      <%= link_to "Log in", signin_path, class: "btn btn-primary" %>
      <%= link_to "Create an account", new_user_path, class: "btn btn-outline" %>
      <a href="https://zoom.us/start/videomeeting" target="_blank" rel="noopener" class="btn btn-ghost">
        Launch Zoom
      </a>
    </div>
  </header>

  <section class="main-grid">
    <article class="panel skyline-panel">
      <h2>Manhattan Morning Feed</h2>
      <p>See who is currently online and ready for a coffee chat.</p>

      <ul class="peer-list">
        <li>
          <strong>Noah</strong>
          <span>Financial District • 8:05 AM</span>
          <button type="button" class="connect-btn" data-peer="Noah">Connect</button>
        </li>
        <li>
          <strong>Ava</strong>
          <span>Chelsea • 8:12 AM</span>
          <button type="button" class="connect-btn" data-peer="Ava">Connect</button>
        </li>
        <li>
          <strong>Mateo</strong>
          <span>Upper West Side • 8:16 AM</span>
          <button type="button" class="connect-btn" data-peer="Mateo">Connect</button>
        </li>
      </ul>

      <p class="status" id="connectionStatus" aria-live="polite">Pick someone to open a Zoom session.</p>
    </article>

    <article class="panel zoom-panel">
      <h2>Zoom Lounge</h2>
      <p class="zoom-subtitle">Embedded access + quick join links for your morning meetings.</p>

      <div class="zoom-shell">
        <p id="zoomRoomName">Morning Manhattan Room</p>
        <a href="https://zoom.us/join" target="_blank" rel="noopener" class="btn btn-primary">Join via Zoom</a>
      </div>

      <div class="transcript-box">
        <label for="zoomTranscript">Live transcript listener</label>
        <textarea id="zoomTranscript" rows="4" placeholder="Type or dictate what is being said in Zoom..."></textarea>
        <div class="transcript-actions">
          <button type="button" class="btn btn-outline" id="simulateTranscript">Simulate Zoom transcript</button>
          <button type="button" class="btn btn-ghost" id="startListening">Mic listen (browser)</button>
        </div>
      </div>
    </article>

    <article class="panel ai-panel">
      <h2>AI Conversation Agent</h2>
      <p>
        The agent listens to your Zoom transcript and recommends smart follow-up prompts
        to keep the conversation flowing.
      </p>

      <div class="agent-chat" id="agentChat" aria-live="polite">
        <p class="agent-message">👋 I’m listening. Share a transcript snippet and I’ll suggest your next line.</p>
      </div>

      <button type="button" class="btn btn-primary" id="recommendPrompt">Recommend next question</button>
    </article>
  </section>
</div>
